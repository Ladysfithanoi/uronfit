# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG đưa .env.local lên git.

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi kết nối Postgres (nút Connect → Session pooler). Chỉ dùng cho
# npm run db:migrate / db:seed trên máy, KHÔNG cần đặt trên Vercel.
# Ký tự đặc biệt trong mật khẩu phải mã hoá, vd @ → %40
DATABASE_URL=postgresql://postgres.xxxxxxxx:MAT_KHAU@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Gmail gửi email đăng nhập / cảnh báo thiết bị ────────────────────────────
GMAIL_USER=urprivategym@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# (tuỳ chọn) tên người gửi
# EMAIL_FROM=UR Private Gym <urprivategym@gmail.com>

# ── Địa chỉ app khi đã triển khai (dùng cho link trong email) ────────────────
# APP_URL=https://urgym.vercel.app

# ── Dữ liệu mẫu (npm run db:seed) ────────────────────────────────────────────
# Email FM thật của chị chủ. Bỏ trống → dùng <GMAIL_USER>+fm@gmail.com
# FM_EMAIL=
# Hộp thư nhận mã của tài khoản demo (mặc định = GMAIL_USER)
# SEED_EMAIL=

# ── AI tạo lịch tập / thực đơn (Google Gemini) ───────────────────────────────
# Nhiều key cách nhau bởi dấu phẩy — app tự xoay vòng khi một key hết hạn mức.
# Lấy key miễn phí tại https://aistudio.google.com/app/apikey
# Bỏ trống: thực đơn dùng bộ giải dự phòng từ CSDL, lịch tập dựng theo quy tắc.
GEMINI_API_KEYS=key1,key2
# (tuỳ chọn) đổi model khi Google ngừng model mặc định
# GEMINI_MODEL=gemini-3.6-flash
